{
  "version": 2,
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/odeal-proxy/:path*",
      "destination": "/api/odeal-proxy?path=:path*"
    },
    {
      "source": "/((?!api/|_expo/|favicon.ico|index.html|metadata.json).*)",
      "destination": "/index.html"
    }
  ]
}
